# Normalize line endings: LF in the repository, native in working copies.
# Without this, a repo authored on Windows shows every line as changed when a
# collaborator on Linux or macOS touches a file.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe misparses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never convert, never diff as text.
*.parquet binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary

# Generated; collapse in PR diffs so review focuses on real changes.
uv.lock linguist-generated=true
