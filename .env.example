# Copy to .env and adjust. .env is gitignored; this file is committed as documentation.

# --- Postgres (must match docker-compose.yml) ---
POSTGRES_USER=adi
POSTGRES_PASSWORD=adi_dev_password
POSTGRES_DB=adi
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Ollama ---
# Ollama runs natively on Windows (not in Docker) so it gets direct GPU access.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Chosen in M1 on measured evidence, not on VRAM guesswork. See docs/decisions.md.
LLM_MODEL=qwen3:4b

# --- Local storage ---
DATA_DIR=./data/datasets

# --- API (M4) ---
# Where the Vite dev server runs. Comma-separated, not JSON: pydantic-settings parses
# complex types from the environment as JSON, and that is a trap in a .env file.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Worker and job queue (M4) ---
# How long an idle worker sleeps before polling again.
WORKER_POLL_INTERVAL_S=1.0
# A running worker refreshes analyses.heartbeat_at this often...
WORKER_HEARTBEAT_INTERVAL_S=5.0
# ...and a RUNNING row quiet for longer than this is presumed orphaned and requeued.
# Must be at least 3x the interval, or one missed beat lets a healthy worker's job be
# stolen. app/config.py refuses to start otherwise.
WORKER_HEARTBEAT_TIMEOUT_S=30.0
# Attempts are counted at CLAIM time, so a job that crashes its worker still burns one.
# After this many, it is failed rather than handed to yet another worker.
ANALYSIS_MAX_ATTEMPTS=3

# --- Agent (M5) ---
# "agent" runs the language model; "fixed" runs M4's deterministic analysis with no
# model at all. Set fixed to prove a failure is the plumbing and not the model.
ANALYSIS_ENGINE=agent
# How many model turns one analysis may take, and how long in total. Two budgets
# because a fast loop going nowhere and one very slow call are different failures.
AGENT_MAX_STEPS=6
AGENT_TIME_BUDGET_S=300
# One model call. Generous: a cold model load is 20-30s before the first token.
LLM_TIMEOUT_S=300
# Zero, always. We want the most probable tool call, not a creative one.
LLM_TEMPERATURE=0.0
# Ollama's default context is 4096 tokens and it TRUNCATES SILENTLY — a schema, sample
# rows and two tool results exceed that, and the model then answers from half a prompt.
LLM_NUM_CTX=16384
# Leave unset so the model's own default applies. M1 measured think=false producing
# WORSE machine-readable output on qwen3, and it is also slower: the model reasons
# either way, and told not to, it does it inside `content` where it must be stripped.
# LLM_THINK=true

# --- Tests ---
# The suite redirects itself to this database and creates it on first run. It empties
# tables, so it must never be pointed at the database the app is using.
# TEST_POSTGRES_DB=adi_test
