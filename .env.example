# Copy to .env and adjust. .env is gitignored; this file is committed as documentation.

# --- Postgres (must match docker-compose.yml) ---
POSTGRES_USER=adi
POSTGRES_PASSWORD=adi_dev_password
POSTGRES_DB=adi
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Ollama ---
# Ollama runs natively on Windows (not in Docker) so it gets direct GPU access.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Chosen in M1 on measured evidence, not on VRAM guesswork. See docs/decisions.md.
#
# THE SINGLE BIGGEST LEVER ON HOW LONG A QUESTION TAKES. qwen3 is a REASONING model: it
# generates ~2,500 tokens of thinking per turn whatever you ask of it, and at ~61 tok/s
# on a 6 GB laptop GPU that is ~40 seconds per turn before it says anything useful.
# Setting `think: false` does NOT help - measured at 42.1s vs 43.6s, because the model
# emits the same tokens either way and merely moves them from `thinking` into `content`.
#
#     qwen3:4b              ~45 s per turn      reasons about everything
#     qwen2.5:3b-instruct   ~1 s per turn       no reasoning trace at all
#
# `ollama pull qwen2.5:3b-instruct` and set it here for a far faster answer. See
# docs/benchmarking.md for what that trade costs in accuracy.
LLM_MODEL=qwen3:4b

# --- Local storage ---
DATA_DIR=./data/datasets

# --- API (M4) ---
# Where the Vite dev server runs. Comma-separated, not JSON: pydantic-settings parses
# complex types from the environment as JSON, and that is a trap in a .env file.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Worker and job queue (M4) ---
# How long an idle worker sleeps before polling again.
WORKER_POLL_INTERVAL_S=1.0
# A running worker refreshes analyses.heartbeat_at this often...
WORKER_HEARTBEAT_INTERVAL_S=5.0
# ...and a RUNNING row quiet for longer than this is presumed orphaned and requeued.
# Must be at least 3x the interval, or one missed beat lets a healthy worker's job be
# stolen. app/config.py refuses to start otherwise.
WORKER_HEARTBEAT_TIMEOUT_S=30.0
# Attempts are counted at CLAIM time, so a job that crashes its worker still burns one.
# After this many, it is failed rather than handed to yet another worker.
ANALYSIS_MAX_ATTEMPTS=3

# --- Agent (M5) ---
# "agent" runs the language model; "fixed" runs M4's deterministic analysis with no
# model at all. Set fixed to prove a failure is the plumbing and not the model.
ANALYSIS_ENGINE=agent
# How many times the model is handed the tools. MEASURED: attaching the tool
# definitions makes it reason 5x longer (1,547 -> 7,972 characters on an identical
# conversation), because with tools in front of it the model re-argues whether to call
# another one every single turn. So the tools go away as soon as there is something to
# answer from, and the answer is written by a call that has none. Two rounds exist only
# to leave room for one repair after a failed query.
AGENT_MAX_TOOL_ROUNDS=2
# A backstop on total model calls, and a wall-clock budget. Two budgets because a loop
# going nowhere and one very slow call are different failures.
AGENT_MAX_STEPS=6
AGENT_TIME_BUDGET_S=300
# One model call. Generous: a cold model load is 20-30s before the first token.
LLM_TIMEOUT_S=300
# Zero, always. We want the most probable tool call, not a creative one.
LLM_TEMPERATURE=0.0
# MEASURED on a 6 GB RTX 4050 with qwen3:4b:
#
#     4096   61.3 tok/s   3.5 GB   100% GPU
#     8192   61.4 tok/s   4.1 GB   100% GPU
#    16384   29.6 tok/s   5.4 GB   17% CPU / 83% GPU     <- 2.07x slower
#
# At 16k the KV cache pushes the model past available VRAM and Ollama silently spills
# layers to the CPU. Nothing warns you; it just takes twice as long. 8192 rather than
# 4096 because Ollama's default of 4096 TRUNCATES SILENTLY, and a real conversation here
# runs ~2,400 prompt tokens plus up to 2,000 generated - over 4096, which would drop the
# head of the prompt (the schema and the grounding rules) with no error at all.
LLM_NUM_CTX=8192
# How long Ollama keeps the model in VRAM. The default is 5 minutes, so a user who
# thinks for six between questions pays a 20-30 second cold load on the next one.
LLM_KEEP_ALIVE=30m
# Leave unset so the model's own default applies. M1 measured think=false producing
# WORSE machine-readable output on qwen3, and it is also slower: the model reasons
# either way, and told not to, it does it inside `content` where it must be stripped.
# LLM_THINK=true

# --- Tests ---
# The suite redirects itself to this database and creates it on first run. It empties
# tables, so it must never be pointed at the database the app is using.
# TEST_POSTGRES_DB=adi_test

# --- Groq (hosted models) ---
# A key at https://console.groq.com/keys unlocks the three hosted models in the picker.
# Leave it empty and everything still works on the local models — the hosted ones are
# simply shown as unavailable, with the reason.
#
# WHAT LEAVES YOUR MACHINE when you choose a hosted model: the schema, three sample
# rows, and the tool RESULTS (capped at 50 rows). Never the file itself. DuckDB still
# runs every query here; only the choosing of what to compute moves off-machine.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# A hosted model that has not answered in a minute is failing, not thinking.
GROQ_TIMEOUT_S=60
